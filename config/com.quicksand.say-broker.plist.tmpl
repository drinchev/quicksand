<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Spec for the qs speech broker (config/qs-say-broker). Rendered per
     sandbox by every build (@SANDBOX_NAME@ etc. substituted) into
     ~/.config/quicksand/brokers/. Quicksand.app, running in the host
     user's GUI session — the only session type whose launchd domain
     carries the speech services — runs ProgramArguments for each
     connection from this sandbox: nothing runs while idle, and the broker
     script lives host-side where the sandbox can't rewrite it. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quicksand.say-broker.@SANDBOX_NAME@</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@BROKER_SCRIPT@</string>
        <string>@SANDBOX_NAME@</string>
    </array>
</dict>
</plist>
