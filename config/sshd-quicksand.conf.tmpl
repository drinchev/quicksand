# Managed by quicksand — rendered by `qs ssh-auth @SANDBOX_NAME@` and on every
# build of that sandbox; edits are overwritten. Remove with:
#   qs ssh-auth @SANDBOX_NAME@ off
#
# SSH logins as the sandbox user are key-only, authorized from a root-owned
# key list (never the sandbox-writable ~/.ssh/authorized_keys), and every
# session is forced through a root-owned wrapper that enters sandbox-exec.
# ZDOTDIR points at an empty root-owned directory so the `zsh -c` sshd uses
# to start the wrapper reads no startup file the sandbox could have written.
Match User @QUICKSAND_USER@
    AuthorizedKeysFile @AUTHORIZED_KEYS@
    ForceCommand @SESSION_COMMAND@
    SetEnv ZDOTDIR=@ZDOTDIR@
    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PermitUserRC no
    AllowAgentForwarding no
    X11Forwarding no
