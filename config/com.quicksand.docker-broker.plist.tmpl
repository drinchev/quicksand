<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Spec for the qs docker broker (config/qs-docker-broker). Rendered per
     sandbox by `qs docker NAME` (@SANDBOX_NAME@ etc. substituted at install
     time) into ~/.config/quicksand/brokers/. Quicksand.app owns the shared
     socket and, for each connection from this sandbox, runs
     ProgramArguments with the connection as stdin/stdout: nothing runs
     while idle, and the broker script plus the docker/jq paths are pinned
     host-side where the sandbox can't rewrite them. Deliberately not in
     ~/Library/LaunchAgents: launchd must never load it. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quicksand.docker-broker.@SANDBOX_NAME@</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@BROKER_SCRIPT@</string>
        <string>@SANDBOX_NAME@</string>
        <string>@SHARED_WORKSPACE@</string>
        <string>@DOCKER_BIN@</string>
        <string>@JQ_BIN@</string>
    </array>
</dict>
</plist>
