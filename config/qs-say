#!/bin/bash
# qs-say MESSAGE... — speak MESSAGE on the host, in the host user's voice.
#
# A sandbox user can't use `say` itself. Text-to-speech resolves voices
# through the com.apple.accessibility.voices service, served by a
# LaunchAgent that launchd only loads into an Aqua (GUI login) session —
# never into the background launchd domain a sudo'd user gets, not even
# when root asks. Audio *output* works fine from here; it's the speech
# engine that is out of reach, so `say` exits 0 having synthesized nothing.
#
# So the text goes to a host-side broker (config/qs-say-broker) over a Unix
# socket in _quicksand/, and that runs `say` as the host user inside their
# GUI session. The broker treats the text as untrusted: it strips control
# characters, caps the length and feeds it to `say` on stdin, never as an
# argument.
#
# Staged into _quicksand/bin/ by the build and installed onto the sandbox
# PATH by profile.d/31-claude-say.sh, which also hooks Claude Code up to it.
set -euo pipefail

SOCK="${QS_SAY_SOCK:-${SHARED_WORKSPACE:?SHARED_WORKSPACE not set}/_quicksand/say.sock}"
[[ $# -ge 1 ]] || { echo "usage: qs-say MESSAGE..." >&2; exit 2; }
[[ -S "$SOCK" ]] || {
    echo "qs-say: broker socket not found at $SOCK — rebuild the sandbox on the host: qs build ${QS_SANDBOX_NAME:-NAME} --rebuild" >&2
    exit 1
}

# One line of text. The broker hangs up as soon as it has read it, before
# speaking, so callers — Claude Code hooks in particular — never wait for
# the speech itself.
MSG="$*"
printf '%s\n' "${MSG//$'\n'/ }" | nc -U "$SOCK" >/dev/null
